<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>ReindexerNet.Embedded</RootNamespace>
    <PackageId>ReindexerNet.Embedded.Native.Win-x64.Min</PackageId>
    <Title>ReindexerNet.Embedded</Title>
    <Description>Reindexer Embedded library (minimal build without RocksDB and gRPC) to embed and run in .net projects.</Description>
    <PackageTags>reindexer embedded document-db in-memory minimal</PackageTags>
    <Version>0.5.1.5010</Version>
    <AssemblyVersion>0.5.1</AssemblyVersion>
    <FileVersion>0.5.1</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="runtimes\**\*" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes" />
  </ItemGroup>

</Project>
